---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/broadsheet.css';
import { articles, issueDate, issueNumber } from '../data/articles';

const [lead, ...rest] = articles;
const leftStory = rest[0];
const rightStory = rest[1];
const issueLabel = String(issueNumber).padStart(3, '0');
const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long',
  timeZone: 'Asia/Tokyo',
}).format(new Date(issueDate + 'T00:00:00+09:00'));

const excerpt = (value: string, sentences = 2) => {
  const parts = value.split('。').map((part) => part.trim()).filter(Boolean);
  return parts.slice(0, sentences).join('。') + (parts.length > 0 ? '。' : '');
};
const articleUrl = (slug: string) => `/articles/${slug}/`;
---

<BaseLayout title="AI最前線新聞 | AI FRONTIER" description="その日、AIの世界で何が起きたのか。公式発表に基づくAIニュースを30秒要約と技術解説で届ける日本語の新聞。">
  <div class="wsj-paper">
    <header class="wsj-masthead" aria-label="新聞の題字と発行情報">
      <div class="wsj-overline">
        <span>AI FRONTIER · INDEPENDENT NEWSPAPER</span>
        <span>AIの進化を、知る楽しさに。</span>
      </div>
      <div class="wsj-title">
        <span class="wsj-emblem" aria-hidden="true">◆</span>
        <div>
          <span class="wsj-english">THE AI FRONTIER JOURNAL</span>
          <h1>AI最前線新聞</h1>
        </div>
        <span class="wsj-emblem" aria-hidden="true">◆</span>
      </div>
      <div class="wsj-dateline">
        <time datetime={issueDate}>{dateLabel}</time>
        <span>創刊号　第{issueLabel}号</span>
        <span>研究・開発・プロダクト・実践</span>
      </div>
    </header>

    <div class="wsj-section-label">
      <strong>本日の一面</strong>
      <span>AI FRONTIER / TODAY'S EDITION</span>
    </div>

    <div class:list={['wsj-columns', !leftStory && 'wsj-columns-one', leftStory && !rightStory && 'wsj-columns-two']}>
      <article class="wsj-main-story">
        <div class="wsj-story-label"><span>一面・最重要ニュース</span><span>{lead.category}</span></div>
        <h2><a href={articleUrl(lead.slug)}>{lead.title}</a></h2>
        <p class="wsj-main-summary">{excerpt(lead.summary, 3)}</p>
        <p class="wsj-main-impact">{lead.whyItMatters}</p>
        <div class="wsj-story-meta">
          <span>発表 {lead.announcedAt}</span>
          <span>読了目安 {lead.readMinutes}分</span>
          <a href={articleUrl(lead.slug)}>記事を読む →</a>
        </div>
      </article>

      {leftStory && (
        <article class="wsj-side-story wsj-side-left">
          <div class="wsj-story-label"><span>注目のニュース</span><span>{leftStory.category}</span></div>
          <h2><a href={articleUrl(leftStory.slug)}>{leftStory.title}</a></h2>
          <p>{excerpt(leftStory.summary, 2)}</p>
          <div class="wsj-story-meta">
            <span>発表 {leftStory.announcedAt}</span>
            <a href={articleUrl(leftStory.slug)}>続きを読む →</a>
          </div>
        </article>
      )}

      {rightStory && (
        <article class="wsj-side-story wsj-side-right">
          <div class="wsj-story-label"><span>研究と実践</span><span>{rightStory.category}</span></div>
          <h2><a href={articleUrl(rightStory.slug)}>{rightStory.title}</a></h2>
          <p>{excerpt(rightStory.summary, 2)}</p>
          <div class="wsj-story-meta">
            <span>発表 {rightStory.announcedAt}</span>
            <a href={articleUrl(rightStory.slug)}>続きを読む →</a>
          </div>
        </article>
      )}
    </div>

    <section class="wsj-inside" aria-labelledby="inside-heading">
      <div class="wsj-inside-heading">
        <h2 id="inside-heading">今号をもっと読む</h2>
        <span>INSIDE THIS ISSUE</span>
      </div>
      <div class="wsj-inside-grid">
        {articles.map((article, index) => (
          <article>
            <span class="wsj-inside-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <div class="wsj-inside-category">{article.category} · {article.readMinutes}分</div>
              <h3><a href={articleUrl(article.slug)}>{article.title}</a></h3>
              <p>{excerpt(article.whyItMatters, 1)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="wsj-edition-note">
      <p><strong>編集部より</strong>　創刊号は公式発表をもとに手動編集しています。自動発行は準備中です。出典と発表日は各記事をご覧ください。</p>
      <a href={`/issues/${issueDate}/`}>創刊号の全記事を見る →</a>
    </div>
  </div>
</BaseLayout>

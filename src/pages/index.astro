---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/broadsheet.css';
import { articles, issueDate, issueNumber } from '../data/articles';

const lead = articles[0];
const sideArticles = articles.slice(1, 3);
const issueLabel = String(issueNumber).padStart(3, '0');
const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long',
  timeZone: 'Asia/Tokyo',
}).format(new Date(issueDate + 'T00:00:00+09:00'));
const heading = (index: number) => ['第一面', '第二面', '第三面'][index] || '記事';
---

<BaseLayout
  title="AI最前線新聞 | AI FRONTIER"
  description="世界のAI技術に、毎号新しい驚きを。一次情報に基づくニュースを、新聞の一面から深く読み解く。"
>
  <div class="paper-page">
    <div class="paper-meta" aria-label="発行情報">
      <span>THE AI FRONTIER PRESS</span>
      <span>{dateLabel}</span>
      <span>創刊　第{issueLabel}号　｜　研究・技術・実践</span>
    </div>

    <div class:list={['paper-body', sideArticles.length === 0 && 'one-story', sideArticles.length === 1 && 'two-stories']}>
      <header class="paper-mast" aria-label="新聞題字">
        <div class="paper-mast-label">独立系AI専門紙</div>
        <h1><span class="paper-mast-ai">AI</span>最前線新聞</h1>
        <p>AIの「今」を知る。</p>
        <div class="paper-mast-edition">創 刊 号</div>
      </header>

      <article class="feature">
        <div class="story-tag">
          <span class="feature-chip">一面</span>
          <span>{lead.category}</span>
          <span>{lead.announcedAt}</span>
        </div>
        <div class="feature-content">
          <h2><a href={"/articles/" + lead.slug + "/"}>{lead.title}</a></h2>
          <div class="feature-text">
            <p>{lead.summary}</p>
            <p>{lead.whyItMatters}</p>
          </div>
        </div>
        <div class="story-bottom">
          <span>第一面　｜　{lead.announcedAt}発表</span>
          <a href={"/articles/" + lead.slug + "/"}>記事を読む ↗</a>
        </div>
      </article>

      {sideArticles.map((article, index) => (
        <article class:list={['brief', index === 0 ? 'brief-top' : 'brief-bottom-row']}>
          <div class="brief-topline">
            <span>{heading(index + 1)}</span>
            <span>{article.category}</span>
            <span>{article.announcedAt}</span>
          </div>
          <div class="brief-content">
            <h2><a href={"/articles/" + article.slug + "/"}>{article.title}</a></h2>
            <p>{article.summary}</p>
          </div>
          <a class="brief-bottom" href={"/articles/" + article.slug + "/"}>続きを読む →</a>
        </article>
      ))}
    </div>

    <section class="lower-section" aria-label="今号の読みどころ">
      <div class="lower-rule">
        <strong>きょうのAI最前線</strong>
        <span>知る、理解する、もっと深く読む。</span>
        <a href={"/issues/" + issueDate + "/"}>今号の全記事を見る ↗</a>
      </div>
      <div class:list={['lower-columns', articles.length === 1 && 'lower-columns-one', articles.length === 2 && 'lower-columns-two']}>
        {articles.map((article, index) => (
          <article>
            <h3><span>{heading(index)}</span><a href={"/articles/" + article.slug + "/"}>{article.title}</a></h3>
            <p>{article.whyItMatters}</p>
          </article>
        ))}
      </div>
    </section>
    <div class="paper-footer">
      AI FRONTIER　／　創刊号 No.{issueLabel}　／　一次情報を確認して編集。現在は手動発行・自動配信準備中
    </div>
  </div>
</BaseLayout>

---
import '../styles/global.css';
import { issueNumber } from '../data/articles';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AI最前線新聞 | AI FRONTIER',
  description = 'AIの進化が、世界をどう変えるのか。公式発表をもとにやさしく・深く伝えるAI専門新聞。',
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-9999px;top:0" onfocus="this.style.left='12px'" onblur="this.style.left='-9999px'">本文へ移動</a>
    <header class={path === '/' ? 'site-header home-topbar' : 'site-header'}>
      <div class="header-inner header-top">
        <a class="brand" href="/" aria-label="AI FRONTIER ホーム">AI FRONTIER <span>AI最前線新聞</span></a>
        <nav class="site-nav" aria-label="主要ナビゲーション">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>最新号</a>
          <a href="/archive/" aria-current={path.startsWith('/issues/') || path.startsWith('/archive/') ? 'page' : undefined}>バックナンバー</a>
          <a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>この新聞について</a>
        </nav>
      </div>
    </header>
    <main id="main" class={path === '/' ? 'frontpage-page' : 'container'}><slot /></main>
    <footer class="footer">
      <div class="container footer-inner">
        <span>© AI FRONTIER · AI最前線新聞</span>
        <span>創刊：2026年11月10日｜一次情報を重視した編集｜{issueNumber === 1 ? '次号の自動発行は設定準備中' : '新号はAI編集・根拠照合を経て公開'}</span>
      </div>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AI最前線新聞 | AI FRONTIER',
  description = '世界のAI技術と現場の実践を、やさしく・深く伝えるAI専門メディア。',
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-9999px;top:0" onfocus="this.style.left='12px'" onblur="this.style.left='-9999px'">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner header-top">
        <a class="brand" href="/" aria-label="AI FRONTIER ホーム">AI FRONTIER <span>AI最前線新聞</span></a>
        <nav class="site-nav" aria-label="主要ナビゲーション">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>今日の新聞</a>
          <a href="/issues/2026-11-09/" aria-current={path.startsWith('/issues/') ? 'page' : undefined}>バックナンバー</a>
          <a href="/about/" aria-current={path.startsWith('/about/') ? 'page' : undefined}>この新聞について</a>
        </nav>
      </div>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="footer">
      <div class="container footer-inner">
        <span>© AI FRONTIER · AI最前線新聞</span>
        <span>試作版｜記事はすべてサンプルです。自動配信は未実装。</span>
      </div>
    </footer>
  </body>
</html>

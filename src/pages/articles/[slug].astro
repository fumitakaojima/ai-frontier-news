---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, type Article } from '../../data/articles';
import { articleVisual } from '../../data/editorialVisuals';
export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}
const { article } = Astro.props as { article: Article };
const visual = articleVisual(article.slug);
---
<BaseLayout title={`${article.title} | AI最前線新聞`} description={article.summary}>
  <div class="article-wrap">
    <a href="/" class="back-link">← 新聞の一面へ</a>
    <div class="eyebrow" style="margin-top:30px">{article.articleType} / VERIFIED SOURCE</div>
    <h1>{article.title}</h1>
    <div class="article-tools">
      <span>{article.category}</span>
      <span>発表：{article.announcedAt}</span>
      <span>本紙掲載：{article.publishedAt}</span>
      <span>読了目安 {article.readMinutes}分</span>
    </div>
    {visual && (
      <figure class="article-visual">
        <img src={visual.src} alt={visual.alt} width="1200" height="800" loading="eager" decoding="async" />
        <figcaption>{visual.caption}</figcaption>
      </figure>
    )}
    <section aria-labelledby="summary-title">
      <div class="eyebrow">LEVEL 1 · 30-SECOND SUMMARY</div>
      <h2 id="summary-title">30秒で理解する</h2>
      <p class="lead">{article.summary}</p>
    </section>
    <section class="article-section" aria-labelledby="meaning-title">
      <div class="eyebrow">WHY IT MATTERS</div>
      <h2 id="meaning-title">なぜ注目なのか</h2>
      <p>{article.whyItMatters}</p>
    </section>
    <section class="article-section" aria-labelledby="technical-title">
      <div class="eyebrow">LEVEL 2 · TECHNICAL DEEP DIVE</div>
      <h2 id="technical-title">技術を深掘りする</h2>
      {article.technical.map((paragraph)=><p>{paragraph}</p>)}
    </section>
    <section class="article-section" aria-labelledby="source-title">
      <h2 id="source-title">一次情報・検証状況</h2>
      <p>発表元の公開資料を確認して編集しました。以下の元情報から、ご自身でも確かめられます。</p>
      <ul>{article.sources.map((source)=><li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label} ↗</a></li>)}</ul>
      <div class="notice" role="note"><strong>検証上の注意：</strong>{article.caveat}</div>
    </section>
    <section class="article-section">
      <a class="back-link" href="/">← トップページに戻る</a>
    </section>
  </div>
</BaseLayout>

<style>
  .article-visual{margin:22px 0 28px}
  .article-visual img{width:100%;height:auto;display:block;border:1px solid #c8cbc3;background:#0a2330}
  .article-visual figcaption{font:500 11px/1.6 system-ui,sans-serif;color:#647069;margin-top:7px}
</style>

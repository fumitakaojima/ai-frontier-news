---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles, issueDate, issueNumber } from '../data/articles';
const lead = articles[0];
const others = articles.slice(1);
const date = new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric',weekday:'long',timeZone:'Asia/Tokyo'}).format(new Date(issueDate+'T00:00:00+09:00'));
---
<BaseLayout title="AI最前線新聞 | AI FRONTIER" description="AIの進化が、世界をどう変えるのか。公式発表に基づくAIニュースを30秒要約と技術解説で届ける日本語の新聞。">
  <div class="edition-mast">
    <div class="edition-topline">THE AI FRONTIER TIMES <span>INDEPENDENT AI NEWSPAPER · JAPAN</span></div>
    <div class="edition-title"><h1>AI最前線新聞</h1><span>AI FRONTIER</span></div>
    <div class="edition-tagline">今日の「すごい！」から、AIの未来が見えてくる。</div>
    <div class="edition-dateline">
      <span>{date}</span>
      <span>創刊号　No. {String(issueNumber).padStart(3,'0')}</span>
      <span>AIの研究・開発・実践</span>
    </div>
  </div>

  <div class="edition-update" role="note">
    <strong>創刊号を公開しました。</strong>
    公式発表をもとに編集した3本を掲載しています。日次自動発行は準備中です。
  </div>

  <section class="front-page" aria-labelledby="top-title">
    <div class="front-page-heading"><span id="top-title">本日の一面</span><span>THE FRONT PAGE</span></div>
    <div class={others.length ? 'newspaper-grid' : 'newspaper-grid single-column'}>
      <article class="paper-lead">
        <div class="paper-category"><span>一面記事</span><span>{lead.category}</span></div>
        <h2><a href={`/articles/${lead.slug}/`}>{lead.title}</a></h2>
        <p class="paper-lead-summary">{lead.summary}</p>
        <div class="paper-facts"><span>発表日：{lead.announcedAt}</span><span>{lead.readMinutes}分で読む</span></div>
        <a href={`/articles/${lead.slug}/`} class="paper-read-more">全文を読む <span aria-hidden="true">→</span></a>
      </article>
      {others.length > 0 && <aside class="paper-rail" aria-label="今号の関連ニュース">
        {others.map((article, i) => <article class="paper-brief">
          <div class="paper-category"><span>{i === 0 ? '第二面' : '第三面'}</span><span>{article.category}</span></div>
          <h3><a href={`/articles/${article.slug}/`}>{article.title}</a></h3>
          <p>{article.summary}</p>
          <div class="paper-facts"><span>発表日：{article.announcedAt}</span><span>{article.readMinutes}分</span></div>
          <a class="paper-read-more" href={`/articles/${article.slug}/`}>記事を読む <span aria-hidden="true">→</span></a>
        </article>)}
      </aside>}
    </div>
  </section>
  <section class="paper-bottom" aria-label="今号の読み方">
    <div>
      <span class="eyebrow">HOW TO READ</span>
      <h2>ニュースを知る。気になったら深く読む。</h2>
      <p>それぞれの記事には、30秒で読める要約と、技術を深掘りする解説、一次情報へのリンクがあります。</p>
    </div>
    <a class="paper-read-more" href={`/issues/${issueDate}/`}>創刊号をまとめて読む →</a>
  </section>
</BaseLayout>

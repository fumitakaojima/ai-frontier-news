---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { issues, type Issue } from '../../data/articles';

export function getStaticPaths() {
  return issues.map((issue) => ({
    params: { date: issue.issueDate },
    props: { issue },
  }));
}
const { issue } = Astro.props as { issue: Issue };
---
<BaseLayout title={`${issue.issueDate}の新聞 | AI最前線新聞`}>
  <div class="masthead">
    <div class="kicker">AI FRONTIER · ARCHIVE</div>
    <h1>{issue.issueDate}の新聞</h1>
    <div class="deck">第{String(issue.issueNumber).padStart(3, '0')}号の全記事</div>
  </div>
  <div class="section-heading">
    <h2>今号の記事</h2>
    <span>{issue.articles.length} STORIES</span>
  </div>
  <ul class="issue-list">
    {issue.articles.map((article) => <li>
      <div class="eyebrow">{article.category} ／ 公式発表 {article.announcedAt}</div>
      <a href={`/articles/${article.slug}/`}>{article.title} →</a>
      <p style="color:#65706a;font-size:13px">{article.summary}</p>
    </li>)}
  </ul>
  <div class="info-strip">
    <div><strong>出典の確認を大切に。</strong><p>発表日と本紙掲載日を区別し、各記事に一次情報と検証上の注意を記載しています。</p></div>
    <a href="/archive/" class="action-link">全バックナンバーを見る →</a>
  </div>
</BaseLayout>
